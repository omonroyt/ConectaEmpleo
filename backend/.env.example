# Copiar a .env y ajustar. Nunca commitear .env (el .gitignore raíz ya lo bloquea).
# Fuente normativa: docs/04_Arquitectura_Tecnica_Backend.md §13 y docs/05_Arquitectura_Sistema_Multiagente.md §0.3.

# --- Base de datos ---
# Coincide con backend/docker-compose.yml (usuario/clave/db "conecta").
DATABASE_URL=postgresql+psycopg://conecta:conecta@localhost:5433/conecta

# --- Identidad / JWT ---
JWT_SECRET=change-me-in-every-environment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS ---
# Lista separada por comas. Incluye siempre el dev server de Vite (:5173) y el
# puerto fijo que usa `frontend/scripts/e2e-smoke.mjs` con Playwright (:5183).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5183,http://127.0.0.1:5183

# --- Entorno ---
ENVIRONMENT=local
# local | staging | production

# --- Almacenamiento de archivos (usado desde B3 en adelante) ---
STORAGE_PROVIDER=local
# local | supabase | s3
STORAGE_BUCKET=conecta-empleo-documents
STORAGE_LOCAL_DIR=./storage

# --- Capa de IA (puerto definido en docs/04 §6 / docs/05 §8; 9 operaciones desde B4) ---
AI_ADAPTER=deterministic
# deterministic | agentic — default global. `agentic` (B11, app/ai/adapters/agentic.py)
# llama a Claude Sonnet 5 de verdad y cae internamente al DeterministicAdapter ante
# falla de proveedor (docs/05 §11.1; sin OpenAI disponible, ver docs/build/06 §9).
# Requiere ANTHROPIC_API_KEY no vacío o falla rápido y explícito al primer uso.
AI_MODE=live
# live | demo — demo fuerza `deterministic` en las 9 operaciones sin excepción (docs/05
# §11.2), ignorando cualquier override. `live` por sí solo NO activa el AgenticAdapter:
# eso lo decide AI_ADAPTER / AI_ADAPTER_<GRUPO> (docs/build/06_INTERVIEW_SYSTEM.md §9:
# "AI_MODE=live por defecto, con demo como respaldo conmutable en caliente").
# Overrides por grupo de operación (vacío = usa AI_ADAPTER). Grupos: cv, interview,
# assessment, advisory, matching (ver app/ai/registry.py).
AI_ADAPTER_CV=
AI_ADAPTER_INTERVIEW=
AI_ADAPTER_ASSESSMENT=
AI_ADAPTER_ADVISORY=
AI_ADAPTER_MATCHING=
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- LLM: primario y failover (docs/05 §0.3, B11) ---
# Sin clave de OpenAI disponible (docs/build/06_INTERVIEW_SYSTEM.md §9): el failover
# real hoy es "reintento en el primario ante fallo de validación -> caída al
# DeterministicAdapter ante fallo de proveedor" (app/ai/adapters/llm/failover.py).
# LLM_FAILOVER_PROVIDER/MODEL quedan declarados como punto de extensión documentado
# para cuando exista una clave de OpenAI real.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PRIMARY_PROVIDER=anthropic
LLM_PRIMARY_MODEL=claude-sonnet-5
LLM_FAILOVER_PROVIDER=openai
LLM_FAILOVER_MODEL=gpt-5.6-terra
LLM_MAX_RETRIES_PRIMARY=2
LLM_TIMEOUT_SECONDS=45
# Override por operación (opcional; vacío = usa el primario). Interruptor para subir
# el Evaluador (A3) a un modelo superior sin tocar código.
LLM_MODEL_ASSESSMENT=
# Temperatura y máximo de tokens SOLO desde configuración (nunca un literal en el
# código). A3 (evaluador) usa temperatura baja y más tokens a propósito (docs/05 §7 A3).
LLM_TEMPERATURE=0.3
LLM_TEMPERATURE_ASSESSMENT=0.1
LLM_MAX_TOKENS=4096
LLM_MAX_TOKENS_ASSESSMENT=8192

# --- Entrevista ---
INTERVIEW_QUESTION_BUDGET=12

# --- Voz (ElevenLabs, B12) ---
VOICE_ENABLED=true
ELEVENLABS_API_KEY=
STT_MODEL=scribe_v1
TTS_MODEL=eleven_flash_v2_5
# voice_id de dos voces reales en español latino de GET /v1/voices (cuenta verificada,
# 28 voces). "Sofía" (perfilador, docs/05 §0.1): Valeria — femenina, latin american,
# conversational. "Daniel" (entrevistador): Enrique González — masculino, mexicano,
# narrative_story (única opción masculina latinoamericana del catálogo; no había una
# etiquetada "conversational"). Descomentar y ajustar si la cuenta cambia de catálogo:
# TTS_VOICE_PROFILER=nfyTTmgO0f6GV9CKrMWL
# TTS_VOICE_INTERVIEWER=pC0w7bOSDTlgiOCrNBX3
TTS_VOICE_PROFILER=
TTS_VOICE_INTERVIEWER=
STT_LANGUAGE=es
TTS_OUTPUT_FORMAT=mp3_22050_32
# Salvaguarda de cuota (obligatoria, docs/build/06_INTERVIEW_SYSTEM.md §9): la cuenta
# payg tiene 10,000 caracteres. Al llegar al 85% el sistema conmuta a texto y lo avisa
# en vez de fallar a media demo (GET /api/v1/voice/quota).
TTS_CHARACTER_BUDGET=10000
TTS_QUOTA_THRESHOLD_PCT=0.85
