# Conecta Empleo — configuración Apache para Hostinger (hosting compartido).
# Sube el contenido de `dist/` a `public_html/` (o al subdirectorio de tu dominio) e
# incluye este archivo tal cual (Vite lo copia automáticamente a `dist/.htaccess`).

# --- SPA fallback: cualquier ruta que no sea un archivo/carpeta real vuelve a index.html ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # No reescribas si la petición apunta a un archivo o carpeta que sí existe
  # (assets, favicon, /demo/*, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo lo demás (rutas de React Router) sirve index.html; el router del lado
  # del cliente resuelve la pantalla real.
  RewriteRule ^ index.html [L]
</IfModule>

# --- Cache largo para los assets con hash de contenido en el nombre ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html nunca debe cachearse: siempre debe apuntar a los assets más recientes.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compresión ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
